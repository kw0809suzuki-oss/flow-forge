diff --git a/crates/ruff_linter/src/rules/refurb/rules/write_whole_file.rs b/crates/ruff_linter/src/rules/refurb/rules/write_whole_file.rs
--- a/crates/ruff_linter/src/rules/refurb/rules/write_whole_file.rs
